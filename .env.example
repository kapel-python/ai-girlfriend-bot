# Telegram Bot Token (от @BotFather)
BOT_TOKEN=

# API ИИ-модели (gptunnel.ru, OpenAI-совместимый)
AI_API_KEY=
AI_BASE_URL=https://gptunnel.ru/v1
DEFAULT_MODEL=deepseek-v4-flash

# Поведение диалога
MESSAGE_DEBOUNCE=2.0
TYPING_SIMULATION=true
SHORT_MEMORY_LIMIT=100

# Ограничения AI/контекста
AI_MAX_CONCURRENCY=4
AI_MAX_REQUESTS_PER_USER_PER_HOUR=60
AI_MAX_BUFFER_MESSAGES=20
AI_MAX_BUFFER_CHARS=12000
AI_MAX_CONTEXT_CHARS=24000

# Путь к базе данных SQLite.
# Для локального запуска можно оставить bot.db; docker-compose переопределяет
# путь на /app/data/bot.db и монтирует ./data.
DATABASE_PATH=bot.db

# Текущий proactive scheduler (DECISION -> TIMING -> максимум одно сообщение)
# Проверки выполняются с интервалом PROACTIVE_CHECK_INTERVAL.
PROACTIVE_ENABLED=true
PROACTIVE_CHECK_INTERVAL=60
PROACTIVE_MIN_DELAY_MINUTES=3
PROACTIVE_MAX_DELAY_MINUTES=720
PROACTIVE_MAX_MESSAGES=4
PROACTIVE_COOLDOWN_MINUTES=20

# DEPRECATED: старые фиксированные стадии эскалации и offense-тайминги.
# Переменные оставлены для совместимости с прежними .env, но текущий
# scheduler их не читает как этапы лестницы; proactive_stage — счётчик.
PROACTIVE_STAGE1_MIN_MINUTES=20
PROACTIVE_STAGE1_MAX_MINUTES=45
PROACTIVE_STAGE2_MIN_MINUTES=180
PROACTIVE_STAGE2_MAX_MINUTES=360
PROACTIVE_OFFENSE_MIN_MINUTES=60
PROACTIVE_OFFENSE_MAX_MINUTES=120

# DEPRECATED: отдельного автоматического «доброго утра» в текущем scheduler
# нет. Настройки оставлены только для совместимости старых конфигураций.
MORNING_START_HOUR=7
MORNING_END_HOUR=11
MORNING_MIN_IDLE_MINUTES=240

# ID администраторов через запятую. Оставьте пустым, если админ-режим не нужен.
# Выбор модели, глобальный промт, typing и debounce — общие для всех.
ADMIN_IDS=

# Характер, custom personality, mood, история и факты хранятся per-user.
# В меню очистки доступны четыре scope: dialog / all / mood / everything.
