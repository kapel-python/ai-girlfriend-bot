# Telegram Bot Token (от @BotFather)
BOT_TOKEN=

# API ИИ-модели (gptunnel.ru, OpenAI-совместимый)
AI_API_KEY=
AI_BASE_URL=https://gptunnel.ru/v1
DEFAULT_MODEL=deepseek-v4-flash

# Поведение диалога
MESSAGE_DEBOUNCE=2.0
TYPING_SIMULATION=true
SHORT_MEMORY_LIMIT=100

# Путь к базе данных SQLite
DATABASE_PATH=bot.db

# Проактивность: стадии эскалации при молчании (минуты)
# стадия 1 — лёгкое «ты куда пропал?», стадия 2 — последняя попытка,
# затем обида (настроение «недовольная») и молчание до его возвращения
PROACTIVE_ENABLED=true
PROACTIVE_STAGE1_MIN_MINUTES=20
PROACTIVE_STAGE1_MAX_MINUTES=45
PROACTIVE_STAGE2_MIN_MINUTES=180
PROACTIVE_STAGE2_MAX_MINUTES=360
PROACTIVE_OFFENSE_MIN_MINUTES=60
PROACTIVE_OFFENSE_MAX_MINUTES=120
PROACTIVE_CHECK_INTERVAL=60
# Proactive timing is sampled independently (log-uniform) for every decision.
PROACTIVE_MIN_DELAY_MINUTES=3
PROACTIVE_MAX_DELAY_MINUTES=720
PROACTIVE_MAX_MESSAGES=4
PROACTIVE_COOLDOWN_MINUTES=20

# «Доброе утро»: окно по Москве и минимальное молчание с ночи (минуты)
MORNING_START_HOUR=7
MORNING_END_HOUR=11
MORNING_MIN_IDLE_MINUTES=240

# ID администраторов через запятую (глобальные настройки: промт, модель, параметры)
ADMIN_IDS=8036527559
